{
  "name": "flow-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Flow Factory — Eve software factory with Flow Skills methodology.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "check": "ultracite check",
    "dev": "eve dev",
    "eval": "eve eval",
    "eval:fast": "eve eval --tag fast",
    "eval:fast:local": "eve eval --tag fast --exclude-tag needs-connect",
    "fix": "ultracite fix",
    "models:check": "node --import tsx scripts/models-check.ts",
    "runs:record": "node --import tsx scripts/runs-record.ts",
    "runs:summary": "node --import tsx scripts/runs-summary.ts",
    "start": "eve start",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc",
    "validate": "pnpm run check && pnpm run typecheck && eve info"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.30",
    "@github-tools/eve-extension": "^0.8.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "^2.3.3",
    "ai": "^7.0.120",
    "eve": "^0.67.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "~24.19.0",
    "microsandbox": "0.5.5",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "ultracite": "^7.12.1"
  },
  "engines": {
    "node": "24.x"
  }
}
