{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "next dev",
    "build": "pnpm run build:mcp-app && next build --webpack",
    "build:mcp-app": "vite build --config mcp-app/vite.config.ts",
    "start": "next start",
    "check-types": "tsc-ts --noEmit",
    "test": "pnpm run build:mcp-app && node --import tsx --test tests/starter.contract.test.ts tests/site-url.test.ts tests/mcp/smoke.test.ts tests/mcp/mcp-app-resource.test.ts tests/mcp/route.test.ts tests/agent-surfaces.test.ts tests/genui-compose.route.test.ts tests/agent/compose-ui.test.ts",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "@openuidev/lang-core": "1.0.1",
    "@repo/genui": "workspace:*",
    "@repo/ui": "workspace:*",
    "ai": "^7.0.152",
    "eve": "^0.83.2",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.1",
    "@repo/ts": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "portless": {
    "name": "app",
    "script": "dev:app"
  }
}
