# Vercel Connect connector UID for GitHub (required).
GITHUB_CONNECTOR=github/foreman-agent

# Optional Linear connector. When set, copy docs/linear-channel.example.ts to
# agent/channels/linear.ts and restart. The Linear MCP connection is enabled automatically.
# LINEAR_CONNECTOR=linear/foreman-agent

# The repository the factory works on. Must be an existing GitHub repository
# in owner/repo format, and the GitHub App behind GITHUB_CONNECTOR must be
# installed with access to it: a station sandbox clones this repository on its
# first session and fails with "Cannot access <owner/repo>" when the app
# cannot reach it. A missing or malformed value fails discovery with a clear
# error.
FACTORY_REPO=acme/widgets

# Model profile: gateway (default), local, or hybrid. Cloud deployments must use gateway.
# FACTORY_MODEL_PROFILE=gateway

# Local / hybrid OpenAI-compatible server (Ollama, LM Studio, etc.)
# FACTORY_LOCAL_BASE_URL=http://localhost:11434/v1
# FACTORY_LOCAL_MODEL_ORCHESTRATOR=qwen3:4b
# FACTORY_LOCAL_MODEL_CLASSIFIER=qwen3:4b
# FACTORY_LOCAL_MODEL_ANALYST=deepseek-r1:8b
# FACTORY_LOCAL_MODEL_RESEARCHER=deepseek-r1:8b
# FACTORY_LOCAL_MODEL_IMPLEMENTER=deepseek-r1:8b
# FACTORY_LOCAL_MODEL_REVIEWER=qwen3:4b
# FACTORY_LOCAL_CONTEXT_ORCHESTRATOR=65536
# Optional vendor labels when model ids do not imply a family (local profile)
# FACTORY_LOCAL_VENDOR_IMPLEMENTER=deepseek
# FACTORY_LOCAL_VENDOR_REVIEWER=qwen

# Optional: runs inside the station sandbox's clone once per session.
# FACTORY_SETUP_COMMAND="pnpm install"

# Optional overrides; every one has a sensible default.
# FACTORY_LABEL="factory"
# FACTORY_BRANCH_PREFIX="factory/"
# FACTORY_BOT_NAME=""
