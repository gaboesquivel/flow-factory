{
  "name": "@repo/flow-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm architecture:check && pnpm ownership:check",
    "check:factory": "pnpm flow:check && pnpm flow-eval:check",
    "test": "node tooling/run-agents-tests.mjs",
    "flow:check": "node tooling/checks/check-flow-docs.mjs && node tooling/checks/check-task-reporting.mjs",
    "flow:test": "node --test tooling/checks/check-flow-docs.test.mjs tooling/checks/check-task-reporting.test.mjs tooling/checks/check-flow-commands.test.mjs",
    "architecture:check": "node tooling/checks/check-react-architecture.mjs",
    "architecture:test": "node --test tooling/checks/check-react-architecture.test.mjs",
    "ownership:check": "node tooling/checks/check-repository-ownership.mjs",
    "ownership:test": "node --test tooling/checks/check-repository-ownership.test.mjs",
    "test:tooling": "node --test tooling/worktrees/*.test.mjs ../tooling/security/*.test.mjs ../tooling/checks/check-staged.test.mjs tooling/checks/conventional-commit.test.mjs tooling/setup/prompt-log.test.mjs tooling/prompt-log/*.test.mjs",
    "worktrees": "node tooling/worktrees/worktrees.mjs",
    "eval": "node --import tsx eval/src/cli.ts",
    "eval:check-types": "node ./node_modules/tsc-ts/bin/tsc-ts.js --noEmit -p eval/tsconfig.json",
    "eval:test": "node --import tsx --test eval/src/*.test.ts eval/src/**/*.test.ts",
    "flow-eval:check": "pnpm eval:check-types && pnpm eval:test && pnpm eval preserve",
    "eval:experiment": "pnpm eval experiment",
    "eval:self-improve": "pnpm eval self-improve",
    "eval:integration-gate": "node eval/scripts/integration-gate.mjs",
    "eval:readiness": "pnpm eval readiness",
    "eval:stress": "pnpm eval stress",
    "eval:mutations": "pnpm eval mutations",
    "eval:benchmark": "pnpm eval benchmark --id benchmark-a && pnpm eval benchmark --id benchmark-b",
    "eval:benchmark:checkout": "node tooling/benchmarks/benchmark-clean-checkout.mjs",
    "skills:install": "pnpm exec skills experimental_install",
    "skills:update": "pnpm exec skills update -p -y",
    "commits:check": "node tooling/checks/check-commits.mjs",
    "security:block-files": "node ../tooling/security/block-secret-files.mjs",
    "security:secrets": "node ../tooling/security/scan-secrets-staged.mjs",
    "security:osv": "node ../tooling/security/scan-osv.mjs",
    "security:check": "node ../tooling/security/security-check.mjs",
    "setup:gitleaks": "node ../tooling/setup/setup-gitleaks.mjs",
    "setup:osv": "node tooling/setup/setup-osv-scanner.mjs",
    "setup:env": "node tooling/setup/setup-env.mjs",
    "update-deps": "node tooling/setup/update-deps.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "postgres": "^3.4.9",
    "skills": "1.7.4",
    "tsc-ts": "^0.0.9",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
